[Unit]
Description=Static site nginx
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/library/nginx:alpine
AutoUpdate=registry
ContainerName=static
Network=frontend.network
Volume=%h/.local/share/container_stacks/static/html:/usr/share/nginx/html:ro
PodmanArgs=--memory=20m

[Service]
Restart=always

[Install]
WantedBy=default.target
