[Unit]
Description=PeerBanHelper
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/ghostchu/peerbanhelper:latest
AutoUpdate=registry
ContainerName=peerbanhelper
HostName=peerbanhelper
Network=frontend.network
User=1003
UserNS=keep-id:uid=1003,gid=1003
Volume=%h/.local/share/container_stacks/peerbanhelper/data:/app/data
StopTimeout=30
PodmanArgs=--memory=512m

[Service]
Restart=always

[Install]
WantedBy=default.target
