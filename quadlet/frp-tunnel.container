[Unit]
Description=SSH tunnel to Tokyo frps downloader ports
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/library/alpine:latest
AutoUpdate=registry
ContainerName=frp_server
Network=frontend.network
Volume=%h/.ssh/config:/root/.ssh/config:ro
Volume=%h/.ssh/id_ed25519:/root/.ssh/id_ed25519:ro
Volume=%h/.ssh/known_hosts:/root/.ssh/known_hosts:ro
Volume=%h/container_stacks/scripts/frp-tunnel.sh:/tunnel.sh:ro
Entrypoint=/bin/sh
Exec=/tunnel.sh
PodmanArgs=--memory=64m

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
